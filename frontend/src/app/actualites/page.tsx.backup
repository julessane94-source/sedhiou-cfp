'use client'

import { useState } from 'react'
import Link from 'next/link'
import Image from 'next/image'

// Données temporaires d'actualités
const actualitesData = [
  {
    id: 1,
    title: 'Journée portes ouvertes 2025',
    slug: 'portes-ouvertes-2025',
    excerpt: 'Venez découvrir nos ateliers et rencontrer nos formateurs le 15 mars 2025.',
    date: '2025-03-01',
    image: '/images/jo.jpg',
    content: '...',
  },
  {
    id: 2,
    title: 'Partenariat avec l’ANPEJ',
    slug: 'partenariat-anpej',
    excerpt: 'Signature d’une convention pour faciliter l’insertion professionnelle de nos lauréats.',
    date: '2025-02-20',
    image: '/images/partenariat.jpg',
  },
  {
    id: 3,
    title: 'Lancement des inscriptions CAP 2025',
    slug: 'inscriptions-cap-2025',
    excerpt: 'Les pré-inscriptions sont ouvertes jusqu’au 30 juin 2025. Places limitées.',
    date: '2025-02-10',
    image: '/images/inscriptions.jpg',
  },
  {
    id: 4,
    title: 'Remise des attestations 2024',
    slug: 'remise-attestations-2024',
    excerpt: 'Cérémonie de remise des diplômes aux 120 lauréats de la promotion 2024.',
    date: '2024-12-05',
    image: '/images/ceremonie.jpg',
  },
]

export default function ActualitesPage() {
  const [search, setSearch] = useState('')

  const filtered = actualitesData.filter(act =>
    act.title.toLowerCase().includes(search.toLowerCase()) ||
    act.excerpt.toLowerCase().includes(search.toLowerCase())
  )

  return (
    <div className="container mx-auto px-4 py-12">
      <h1 className="text-4xl font-bold text-center mb-4">Actualités du CFP SEDHIOU</h1>
      <p className="text-center text-gray-600 mb-12 max-w-2xl mx-auto">
        Toute l’actualité de notre centre : événements, partenariats, inscriptions…
      </p>

      <div className="mb-8 max-w-md mx-auto">
        <input
          type="text"
          placeholder="Rechercher une actualité..."
          value={search}
          onChange={(e) => setSearch(e.target.value)}
          className="w-full border rounded-lg px-4 py-2"
        />
      </div>

      <div className="space-y-8">
        {filtered.map(act => (
          <article key={act.id} className="bg-white rounded-xl shadow-md overflow-hidden md:flex">
            <div className="md:w-1/3 h-48 md:h-auto bg-gray-200 flex items-center justify-center text-gray-500">
              📰 Image
            </div>
            <div className="p-6 md:w-2/3">
              <div className="flex items-center gap-2 text-sm text-gray-500 mb-2">
                <span>📅 {new Date(act.date).toLocaleDateString('fr-FR')}</span>
              </div>
              <h2 className="text-2xl font-bold mb-2">{act.title}</h2>
              <p className="text-gray-600 mb-4">{act.excerpt}</p>
              <Link href={`/actualites/${act.slug}`} className="text-primary font-semibold hover:underline">
                Lire la suite →
              </Link>
            </div>
          </article>
        ))}
      </div>
    </div>
  )
}
