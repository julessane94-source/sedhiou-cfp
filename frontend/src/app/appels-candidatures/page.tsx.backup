'use client'

import { useState } from 'react'
import Link from 'next/link'

// Données d'appels
const appelsData = [
  {
    id: 1,
    title: 'CAP Horticulteur – session 2025',
    deadline: '2025-06-30',
    status: 'open',
    description: 'Formation en alternance possible. 30 places disponibles.',
    link: '/inscription?formation=cap-horticulteur',
  },
  {
    id: 2,
    title: 'Attestation Coiffure',
    deadline: '2025-05-15',
    status: 'open',
    description: 'Début des cours en septembre. Niveau débutant accepté.',
    link: '/inscription',
  },
  {
    id: 3,
    title: 'CAP Développement Local',
    deadline: '2025-04-20',
    status: 'closed',
    description: 'Les candidatures sont closes pour cette session.',
    link: '#',
  },
  {
    id: 4,
    title: 'CAP Cuisinier',
    deadline: '2025-07-10',
    status: 'open',
    description: 'Formation intensive avec stage en entreprise.',
    link: '/inscription',
  },
]

export default function AppelsPage() {
  const [filter, setFilter] = useState<'all' | 'open' | 'closed'>('all')
  const now = new Date()

  const filteredAppels = appelsData.filter(a => {
    if (filter === 'all') return true
    return a.status === filter
  })

  const isOpen = (deadline: string) => new Date(deadline) > now && a.status === 'open'

  return (
    <div className="container mx-auto px-4 py-12">
      <h1 className="text-4xl font-bold text-center mb-4">Appels à candidatures</h1>
      <p className="text-center text-gray-600 mb-8 max-w-2xl mx-auto">
        Postulez dès maintenant aux formations ouvertes. Les places sont limitées.
      </p>

      <div className="flex justify-center gap-4 mb-8">
        <button onClick={() => setFilter('all')} className={`px-4 py-2 rounded-full ${filter === 'all' ? 'bg-primary text-white' : 'bg-gray-200'}`}>Tous</button>
        <button onClick={() => setFilter('open')} className={`px-4 py-2 rounded-full ${filter === 'open' ? 'bg-primary text-white' : 'bg-gray-200'}`}>Ouverts</button>
        <button onClick={() => setFilter('closed')} className={`px-4 py-2 rounded-full ${filter === 'closed' ? 'bg-primary text-white' : 'bg-gray-200'}`}>Clos</button>
      </div>

      <div className="grid md:grid-cols-2 gap-6">
        {filteredAppels.map(appel => {
          const dateLimit = new Date(appel.deadline)
          const isOpenNow = appel.status === 'open' && dateLimit > new Date()
          return (
            <div key={appel.id} className={`border rounded-xl p-6 shadow-sm ${!isOpenNow ? 'bg-gray-50 opacity-80' : 'bg-white'}`}>
              <div className="flex justify-between items-start mb-2">
                <h2 className="text-xl font-bold">{appel.title}</h2>
                <span className={`text-sm px-2 py-1 rounded-full ${isOpenNow ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700'}`}>
                  {isOpenNow ? 'Ouvert' : 'Clos'}
                </span>
              </div>
              <p className="text-gray-600 mb-2">{appel.description}</p>
              <p className="text-sm text-gray-500 mb-4">📅 Date limite : {dateLimit.toLocaleDateString('fr-FR')}</p>
              {isOpenNow ? (
                <Link href={appel.link} className="inline-block bg-primary text-white px-4 py-2 rounded hover:bg-blue-700 transition">
                  Postuler maintenant
                </Link>
              ) : (
                <button disabled className="bg-gray-300 text-gray-500 px-4 py-2 rounded cursor-not-allowed">Candidatures closes</button>
              )}
            </div>
          )
        })}
      </div>
    </div>
  )
}
